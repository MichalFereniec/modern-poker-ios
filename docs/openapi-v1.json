      "PokerExercise": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "heroCards",
          "board",
          "pot",
          "callAmount",
          "opponentRange"
        ],
        "description": "Wszystkie karty heroCards i board muszą być unikalne również pomiędzy tymi tablicami. callAmount <= pot. Backend nie publikuje tu ukrytych kart przeciwnika, equity ani analizy.",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ExerciseID"
          },
          "heroCards": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          },
          "board": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Card"
            },
            "description": "Flop (3 karty) albo turn (4 karty), w kolejności rozdania."
          },
          "pot": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "description": "Aktualna pula żetonów obejmująca już all-in rywala, bez kosztu bieżącego sprawdzenia gracza. Musi być >= callAmount."
          },
          "callAmount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "description": "Dodatkowy koszt call. 0 < callAmount <= pot."
          },
          "opponentRange": {
            "$ref": "#/components/schemas/OpponentRange"
          }
        },
        "examples": [
          {
            "id": "ex_royal_flush_01",
            "heroCards": [
              {
                "rank": 14,
                "suit": "s"
              },
              {
                "rank": 13,
                "suit": "s"
              }
            ],
            "board": [
              {
                "rank": 12,
                "suit": "s"
              },
              {
                "rank": 11,
                "suit": "s"
              },
              {
                "rank": 10,
                "suit": "s"
              }
            ],
            "pot": 150,
            "callAmount": 50,
            "opponentRange": {
              "id": "strong_pairs",
              "name": "Mocne pary",
              "description": "Rywal zagrywa all-in z parą waletów, dam, króli lub asów. Każda legalna kombinacja kart jest jednakowo prawdopodobna.",
              "hands": [
                "JJ",
                "QQ",
                "KK",
                "AA"
              ]
            }
          }
        ]
      },
      "DecisionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/PokerAction"
          }
        }
      },
      "DecisionAnalysis": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exerciseId",
          "selectedAction",
          "equity",
          "requiredEquity",
          "callEV",
          "recommendedAction",
          "acceptableActions",
          "isCorrect",
          "explanation",
          "sampleCount",
          "marginOfError"
        ],
        "description": "Wyniki dla jawnego zakresu z tego samego ćwiczenia. Wartości numeryczne są skończone. EV fold wynosi 0; koszt już zainwestowany w pulę nie jest odejmowany ponownie. Przy porównywaniu przeliczonych wartości klient powinien uwzględnić tolerancję zmiennoprzecinkową.",
        "properties": {
          "exerciseId": {
            "$ref": "#/components/schemas/ExerciseID"
          },
          "selectedAction": {
            "$ref": "#/components/schemas/PokerAction"
          },
          "equity": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 1,
            "description": "Oczekiwany udział gracza w puli: P(wygrana) + 0.5 * P(remis). Obliczony względem wszystkich legalnych kombinacji zakresu i możliwych dokończeń stołu."
          },
          "requiredEquity": {
            "type": "number",
            "format": "double",
            "exclusiveMinimum": 0,
            "maximum": 0.5,
            "description": "Dokładnie callAmount / (pot + callAmount). Wartość maksymalna 0.5 wynika z callAmount <= pot."
          },
          "callEV": {
            "type": "number",
            "format": "double",
            "minimum": -1000000,
            "maximum": 1000000,
            "description": "equity * (pot + callAmount) - callAmount, w żetonach względem fold."
          },
          "recommendedAction": {
            "$ref": "#/components/schemas/PokerAction",
            "description": "call, gdy callEV >= 0; fold, gdy callEV < 0. Rekomendacja punktowa nie usuwa niepewności pomiaru."
          },
          "acceptableActions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/PokerAction"
            },
            "description": "Oba ruchy, jeśli domknięty przedział equity ± marginOfError przycięty do [0,1] obejmuje requiredEquity. Inaczej tylko call, gdy przedział leży powyżej progu, lub tylko fold, gdy poniżej. Przy dokładnej równości EV=0 oba ruchy są akceptowane."
          },
          "isCorrect": {
            "type": "boolean",
            "description": "Dokładnie acceptableActions.contains(selectedAction)."
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Przygotowane przez backend polskie wyjaśnienie z rzeczywistymi liczbami ćwiczenia. Nie wymaga LLM. Zaznacza niepewność, jeśli oba ruchy są akceptowane."
          },
          "sampleCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000,
            "description": "0 oznacza pełną enumerację, bez błędu Monte Carlo. Wartość dodatnia to liczba niezależnych, równomiernych prób Monte Carlo (nie liczba różnych układów). Powtórzenia całych prób są dozwolone."
          },
          "marginOfError": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 1,
            "description": "Konserwatywny dwustronny błąd 95% dla niezależnych prób z wynikiem 0, 0.5 lub 1: min(1, sqrt(ln(40) / (2 * sampleCount))). Dla pełnej enumeracji sampleCount=0 wartość wynosi 0. Jest to bezwzględna szerokość w skali equity 0…1, a nie względny procent."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "sampleCount": {
                  "const": 0
                }
              },
              "required": [
                "sampleCount"
              ]
            },
            "then": {
              "properties": {
                "marginOfError": {
                  "const": 0
                }
              }
            },
            "else": {
              "properties": {
                "marginOfError": {
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        ],
        "examples": [
          {
            "exerciseId": "ex_royal_flush_01",
            "selectedAction": "call",
            "equity": 1,
            "requiredEquity": 0.25,
            "callEV": 150,
            "recommendedAction": "call",
            "acceptableActions": [
              "call"
            ],
            "isCorrect": true,
            "explanation": "Masz pokera królewskiego, więc wygrywasz przy każdym dokończeniu rozdania. Sprawdzenie za 50 powiększa pulę do 200. Potrzebujesz 25% equity, a masz 100%. Oczekiwana wartość sprawdzenia względem spasowania wynosi +150 żetonów.",
            "sampleCount": 0,
            "marginOfError": 0
          },
          {
            "exerciseId": "ex_close_decision_02",
            "selectedAction": "fold",
            "equity": 0.251,
            "requiredEquity": 0.25,
            "callEV": 0.2,
            "recommendedAction": "call",
            "acceptableActions": [
              "call",
              "fold"
            ],
            "isCorrect": true,
            "explanation": "Szacowane equity wynosi 25,1%, a próg opłacalności 25%. To różnica mniejsza niż błąd symulacji. Obie odpowiedzi uznajemy za poprawne; do stanowczej oceny potrzeba dokładniejszego obliczenia.",
            "sampleCount": 10000,
            "marginOfError": 0.013581015157406196
          }
        ]
      },
      "APIError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "validation_error",
              "unsupported_media_type",
              "exercise_not_found",
              "exercise_expired",
              "simulation_unavailable"
            ],
            "description": "Stabilny kod do obsługi błędu przez klienta."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Zrozumiały dla użytkownika komunikat po polsku, bez wewnętrznych szczegółów serwera."
          }
        }
      }
    }
  }
}
