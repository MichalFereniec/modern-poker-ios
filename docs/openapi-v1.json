{
  "openapi": "3.1.1",
  "info": {
    "title": "Modern Poker — API trenera decyzji",
    "version": "1.0.0",
    "description": "Kontrakt demonstracyjnej aplikacji iOS. Texas Hold’em, heads-up, decyzja call/fold wobec all-in na flopie albo turnie. Serwer generuje ćwiczenie, przechowuje je co najmniej 30 minut i ocenia decyzję według oczekiwanej wartości żetonów. Brak prowizji, ICM, dodatkowych pul, dalszej licytacji i autoryzacji. API służy do nauki przy jawnie założonym zakresie przeciwnika.\n\nWszystkie wartości pieniężne oznaczają fikcyjne żetony. `pot` zawiera już all-in przeciwnika i wszystkie wcześniejsze wpłaty, lecz nie zawiera jeszcze `callAmount` gracza. `requiredEquity = callAmount / (pot + callAmount)`. `callEV = equity * (pot + callAmount) - callAmount`; fold ma EV równe 0 względem chwili decyzji. Equity uwzględnia połowę puli za remis.\n\nLosowanie kart i zakresów nie zależy od historii gracza, jego aktywności ani wyników. W obrębie jawnego zakresu wszystkie legalne konkretne kombinacje dwóch kart przeciwnika są jednakowo prawdopodobne. Nie należy losować klas rąk z równym prawdopodobieństwem. Po usunięciu kart gracza i stołu losuje się legalną kombinację rywala, a następnie pozostałe karty stołu równomiernie bez zwracania. Wynik symulacji jest obliczany lub utrwalany dla danego ćwiczenia przed oceną odpowiedzi i ponowne decyzje nie zmieniają equity.\n\nWszystkie odpowiedzi JSON mają Content-Type application/json. Błędy używają wspólnego modelu APIError. Backend musi sprawdzać również opisane w schematach zależności między polami, których JSON Schema nie wyraża arytmetycznie."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Lokalny backend dla symulatora iOS."
    },
    {
      "url": "http://{host}:8080",
      "description": "Backend w tej samej zaufanej sieci LAN co iPhone; host to adres komputera.",
      "variables": {
        "host": {
          "default": "192.168.1.10",
          "description": "Adres IP komputera z backendem."
        }
      }
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Exercises",
      "description": "Losowanie ćwiczeń i ocena decyzji."
    }
  ],
  "paths": {
    "/v1/exercises": {
      "post": {
        "operationId": "createExercise",
        "tags": [
          "Exercises"
        ],
        "summary": "Wylosuj nowe ćwiczenie call/fold.",
        "description": "Zwraca dwa różne odkryte hole cards gracza, trzy albo cztery różne karty stołu, pulę, koszt sprawdzenia i jawny zakres rywala. Widoczne karty nie mogą się powtarzać; dla flopa znanych jest pięć kart, dla turna sześć. Nie ujawnia equity, poprawnej odpowiedzi, wyniku symulacji ani konkretnych kart rywala. Ćwiczenie pozostaje dostępne przez co najmniej 30 minut od utworzenia. Każde wywołanie tworzy nowy identyfikator. Puste body JSON `{}` jest wymagane.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExerciseRequest"
              },
              "example": {}
            }
          }
        },
        "responses": {
          "201": {
            "description": "Utworzono ćwiczenie. Pozostałe karty i analizę przechowuje backend.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PokerExercise"
                },
                "examples": {
                  "royalFlush": {
                    "summary": "Flop z gotowym pokerem królewskim; przykład o dokładnie znanym equity.",
                    "value": {
                      "id": "ex_royal_flush_01",
                      "heroCards": [
                        {
                          "rank": 14,
                          "suit": "s"
                        },
                        {
                          "rank": 13,
                          "suit": "s"
                        }
                      ],
                      "board": [
                        {
                          "rank": 12,
                          "suit": "s"
                        },
                        {
                          "rank": 11,
                          "suit": "s"
                        },
                        {
                          "rank": 10,
                          "suit": "s"
                        }
                      ],
                      "pot": 150,
                      "callAmount": 50,
                      "opponentRange": {
                        "id": "strong_pairs",
                        "name": "Mocne pary",
                        "description": "Rywal zagrywa all-in z parą waletów, dam, króli lub asów. Każda legalna kombinacja kart jest jednakowo prawdopodobna.",
                        "hands": [
                          "JJ",
                          "QQ",
                          "KK",
                          "AA"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Niepoprawna składnia JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                },
                "examples": {
                  "default": {
                    "value": {
                      "code": "invalid_request",
                      "message": "Treść żądania nie jest poprawnym obiektem JSON."
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Nieobsługiwany Content-Type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                },
                "examples": {
                  "default": {
                    "value": {
                      "code": "unsupported_media_type",
                      "message": "Wyślij żądanie jako application/json."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "JSON nie spełnia schematu żądania.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                },
                "examples": {
                  "default": {
                    "value": {
                      "code": "validation_error",
                      "message": "Tworzenie ćwiczenia wymaga pustego obiektu JSON."
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Symulator chwilowo niedostępny; można ponowić żądanie.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                },
                "examples": {
                  "default": {
                    "value": {
                      "code": "simulation_unavailable",
                      "message": "Nie udało się przygotować ćwiczenia. Spróbuj ponownie."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/exercises/{id}/decisions": {
      "post": {
        "operationId": "submitDecision",
        "tags": [
          "Exercises"
        ],
        "summary": "Oceń decyzję i ujawnij analizę ćwiczenia.",
        "description": "Można wielokrotnie oceniać call lub fold dla tego samego ćwiczenia. Equity, wymagane equity, EV, rekomendacja, dopuszczalne odpowiedzi i parametry symulacji pozostają identyczne; selectedAction i isCorrect odpowiadają bieżącemu żądaniu. Ocena zależy od dostępnych informacji i zadanego zakresu, a nie od jednego wylosowanego wyniku rozdania.\n\n`recommendedAction` to call dla callEV >= 0, w przeciwnym razie fold. Aby nie karać za szum Monte Carlo, `acceptableActions` zawiera oba ruchy, jeśli domknięty przedział [max(0, equity - marginOfError), min(1, equity + marginOfError)] obejmuje requiredEquity. Jeśli cały przedział leży wyżej, dopuszczalny jest tylko call; jeśli niżej, tylko fold. `isCorrect` oznacza, że acceptableActions zawiera selectedAction.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identyfikator zwrócony podczas tworzenia ćwiczenia.",
            "schema": {
              "$ref": "#/components/schemas/ExerciseID"
            },
            "example": "ex_royal_flush_01"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              },
              "examples": {
                "call": {
                  "value": {
                    "action": "call"
                  }
                },
                "fold": {
                  "value": {
                    "action": "fold"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Analiza decyzji. Ułamki 0…1 klient wyświetla jako procenty.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionAnalysis"
                },
                "examples": {
                  "exact": {
                    "summary": "Dokładne equity: sprawdzenie z pokerem królewskim.",
                    "value": {
                      "exerciseId": "ex_royal_flush_01",
                      "selectedAction": "call",
                      "equity": 1,
                      "requiredEquity": 0.25,
                      "callEV": 150,
                      "recommendedAction": "call",
                      "acceptableActions": [
                        "call"
                      ],
                      "isCorrect": true,
                      "explanation": "Masz pokera królewskiego, więc wygrywasz przy każdym dokończeniu rozdania. Sprawdzenie za 50 powiększa pulę do 200. Potrzebujesz 25% equity, a masz 100%. Oczekiwana wartość sprawdzenia względem spasowania wynosi +150 żetonów.",
                      "sampleCount": 0,
                      "marginOfError": 0
                    }
                  },
                  "uncertain": {
                    "summary": "Niezależny przykład decyzji blisko progu: obie akcje akceptowane.",
                    "value": {
                      "exerciseId": "ex_close_decision_02",
                      "selectedAction": "fold",
                      "equity": 0.251,
                      "requiredEquity": 0.25,
                      "callEV": 0.2,
                      "recommendedAction": "call",
                      "acceptableActions": [
                        "call",
                        "fold"
                      ],
                      "isCorrect": true,
                      "explanation": "Szacowane equity wynosi 25,1%, a próg opłacalności 25%. To różnica mniejsza niż błąd symulacji. Obie odpowiedzi uznajemy za poprawne; do stanowczej oceny potrzeba dokładniejszego obliczenia.",
                      "sampleCount": 10000,
                      "marginOfError": 0.013581015157406196
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Niepoprawna składnia JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                },
                "examples": {
                  "default": {
                    "value": {
                      "code": "invalid_request",
                      "message": "Treść żądania nie jest poprawnym obiektem JSON."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Nieznany identyfikator ćwiczenia.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                },
                "examples": {
                  "default": {
                    "value": {
                      "code": "exercise_not_found",
                      "message": "Nie znaleziono tego ćwiczenia. Wylosuj nowe rozdanie."
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "Ćwiczenie wygasło po upływie co najmniej 30 minut.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                },
                "examples": {
                  "default": {
                    "value": {
                      "code": "exercise_expired",
                      "message": "To ćwiczenie wygasło. Wylosuj nowe rozdanie."
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Nieobsługiwany Content-Type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                },
                "examples": {
                  "default": {
                    "value": {
                      "code": "unsupported_media_type",
                      "message": "Wyślij żądanie jako application/json."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Niepoprawny identyfikator lub akcja spoza call/fold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                },
                "examples": {
                  "default": {
                    "value": {
                      "code": "validation_error",
                      "message": "Akcja musi mieć wartość call albo fold."
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Analiza chwilowo niedostępna; można ponowić tę samą decyzję.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                },
                "examples": {
                  "default": {
                    "value": {
                      "code": "simulation_unavailable",
                      "message": "Nie udało się obliczyć analizy. Spróbuj ponownie."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateExerciseRequest": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0,
        "description": "Pusty obiekt JSON. Pierwsza wersja nie przyjmuje parametrów personalizacji."
      },
      "ExerciseID": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_-]+$",
        "description": "Nieprzezroczysty identyfikator ćwiczenia bez separatorów URL."
      },
      "PokerAction": {
        "type": "string",
        "enum": [
          "call",
          "fold"
        ]
      },
      "Card": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "suit"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 2,
            "maximum": 14,
            "description": "2…10, walet=11, dama=12, król=13, as=14."
          },
          "suit": {
            "type": "string",
            "enum": [
              "c",
              "d",
              "h",
              "s"
            ],
            "description": "c=trefl, d=karo, h=kier, s=pik."
          }
