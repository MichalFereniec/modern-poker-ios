            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Krótka polska nazwa zakresu."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Polski opis założenia, widoczny przed decyzją; nie zdradza equity ani oceny."
          },
          "hands": {
            "type": "array",
            "minItems": 1,
            "maxItems": 169,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/HandClass"
            },
            "description": "Pełna lista klas. Każdą należy rozwinąć na konkretne kombinacje, usunąć kombinacje zawierające widoczne karty, a pozostałym nadać równe wagi. Po usunięciu blokowanych kombinacji musi pozostać co najmniej jedna."
          }
